# Cluster to settle on.
TOLLWAY_NETWORK=devnet

# Where payments land. Must be a wallet you control.
TOLLWAY_MERCHANT_WALLET=

# Optional overrides.
# TOLLWAY_RPC_URL=https://api.devnet.solana.com
# TOLLWAY_CURRENCY=sol
# TOLLWAY_INVOICE_TTL=900
# TOLLWAY_PUBLIC_URL=http://localhost:4021
# PORT=4021

# Panta prediction-market provider. Enables the nine panta-* resources.
# Get a key at https://docs.panta.market (auth/register, then account/keys).
# PANTA_API_KEY=pk_test_...
# PANTA_BASE_URL=https://live-api.panta.market/api/v1
